{
  "expo": {
    "name": "Setframe",
    "slug": "setframe",
    "scheme": "setframe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.setframe.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Setframe reads Apple Health activity, heart, and body metrics to show them on your Today screen and keep your training history in sync.",
        "NSHealthUpdateUsageDescription": "Setframe does not write data to Apple Health.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.setframe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#364bf2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#364bf2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4fc691d-addc-43b4-b078-31e6aad6b013"
      }
    },
    "owner": "setframes-team",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
