# Placeholder Clerk publishable key until a real one is provisioned in the
# Clerk dashboard (see docs/adr/0002-auth-clerk.md). Structured so this is
# the only value that needs to change.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Base URL for the Fastify API, including the /v1 prefix (docs/api.md).
# apps/api's dev port wasn't finalized when this was written.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/v1

# Optional, development only. Lands the app directly on a route instead of
# Today, so a screen can be inspected on the Simulator without tapping —
# `simctl` has no tap primitive. Ignored entirely in production builds
# (guarded on __DEV__ in app/index.tsx) and never skips the auth gate.
# Restart Metro after changing it. Examples:
#   EXPO_PUBLIC_DEV_INITIAL_ROUTE=/(tabs)/training
#   EXPO_PUBLIC_DEV_INITIAL_ROUTE=/(tabs)/progress
# EXPO_PUBLIC_DEV_INITIAL_ROUTE=
