# Base URL for the Setline Fastify API. Port is configurable — apps/api's
# dev server port was not yet finalized at the time this was written, so
# 3000 is the placeholder default (see src/lib/env.ts).
VITE_API_BASE_URL=http://localhost:3000/v1

# Placeholder Clerk publishable key — drop in a real one from the Clerk
# dashboard when available. Structured so this is the only change needed.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
