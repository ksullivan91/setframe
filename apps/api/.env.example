# Copy to .env for local development. All values below are placeholders —
# the server boots and /v1/health responds even with these dummy values;
# DB/Clerk-backed routes will fail at request time until real values are
# supplied (see packages/config/src/index.ts `parseApiEnv`).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Comma-separated allowlist. Production should include the primary Pages
# origin plus preview wildcard(s), e.g.
# https://setframe-web.pages.dev,https://*.setframe-web.pages.dev
CORS_ORIGIN=http://localhost:5173
